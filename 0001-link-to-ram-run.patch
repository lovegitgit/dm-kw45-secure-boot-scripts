     ${FPU} \
     ${SPECS} \
-    -T\"${ProjDirPath}/devices/Wireless/KW/KW45B41Z83/gcc/KW45B41Z83xxxA_flash.ld\" -static \
+    -T\"${ProjDirPath}/devices/Wireless/KW/KW45B41Z83/gcc/KW45B41Z83xxxA_ram.ld\" -static \
 ")
