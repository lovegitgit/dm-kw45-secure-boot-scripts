 .../KW/KW45B41Z83/gcc/KW45B41Z83xxxA_ram.ld   | 187 ++++++++++++++++++
 .../KW/KW45B41Z83/gcc/startup_KW45B41Z83.S    |  15 +-
 .../KW/KW45B41Z83/system_KW45B41Z83.c         |   9 +
